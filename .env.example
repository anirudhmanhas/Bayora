# ==============================================================================
# Bayora POC - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Docker Runtime (runsc for gVisor hosts; runc for local dev fallback)
DOCKER_RUNTIME=runc


# Gateway Configuration
GATEWAY_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Downstream Service URLs (Reachable by Gateway)
AUDIT_SERVICE_URL=http://audit:8000
DEFENSE_RUNNER_URL=http://defense-runner:8000
MODEL_SERVICE_URL=http://model-service:8000

# Container Resource Limits & CPU Affinity
# If your VM has 1 vCPU (available: 0), keep these as 0.
# If your VM/host has 4+ vCPUs, pin them to separate cores: RED_CPUSET=0, BLUE_CPUSET=1, MODEL_CPUSET=2, GATEWAY_CPUSET=3
RED_CPUSET=0
BLUE_CPUSET=0
MODEL_CPUSET=0
GATEWAY_CPUSET=0

RED_CPUS=1.0
BLUE_CPUS=1.0
MODEL_CPUS=1.0
GATEWAY_CPUS=1.0
DEFENSE_CPUS=1.0
AUDIT_CPUS=1.0

RED_MEM_LIMIT=256m
BLUE_MEM_LIMIT=256m
MODEL_MEM_LIMIT=512m
GATEWAY_MEM_LIMIT=512m
DEFENSE_MEM_LIMIT=256m
AUDIT_MEM_LIMIT=256m

RED_BLKIO_WEIGHT=300
BLUE_BLKIO_WEIGHT=300

# Optional Response Padding (Milliseconds, 0 = disabled)
RESPONSE_PADDING_MS=0

#GROQ api key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b