# ==============================================================================
# Bayora POC - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Gateway Configuration
GATEWAY_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Authentication Tokens
ADMIN_TOKEN=placeholder_admin_secret_token
RED_TEAM_TOKEN=placeholder_red_team_token
BLUE_TEAM_TOKEN=placeholder_blue_team_token

# Downstream Service URLs (Reachable by Gateway)
AUDIT_SERVICE_URL=http://audit:8000
DEFENSE_RUNNER_URL=http://defense-runner:8000
MODEL_SERVICE_URL=http://model-service:8000

# Model Provider Settings
MODEL_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cryptographic Audit Salt
AUDIT_SECRET_SALT=placeholder_audit_salt_value
